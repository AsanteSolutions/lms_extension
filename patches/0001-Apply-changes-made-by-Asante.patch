 frontend/src/pages/Courses/Courses.vue   | 41 +++++++++++++++++-------
 frontend/src/utils/index.js              |  5 +++
 frontend/vite.config.js                  |  4 +--
 frontend/vite.signup-select.config.js    |  4 +--
 lms_extension/templates/signup-form.html |  4 +--
 6 files changed, 43 insertions(+), 19 deletions(-)

diff --git a/frontend/package.json b/frontend/package.json
